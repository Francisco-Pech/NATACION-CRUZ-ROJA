DATABASE_URL="postgresql://natacion:natacion_local@localhost:5433/natacion"
SESSION_SECRET="cambiar-en-produccion"
TZ="America/Cancun"

# Cobro en línea. Vacías = corre la pasarela simulada (no cobra dinero real).
# Al poner las llaves reales de Stripe, el sistema cambia solo a cobro real.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Lo entrega Stripe al dar de alta el webhook contra la dirección pública.
# Sin esto ningún pago en línea se da por bueno: el aviso firmado es la
# única fuente de verdad, y sin la firma no se procesa nada.
STRIPE_WEBHOOK_SECRET=""

# La dirección pública del sitio, con https y sin diagonal final. Stripe
# exige direcciones absolutas para volver del cobro, y de aquí sale también
# el enlace del código QR del alumno.
URL_PUBLICA=""

# ---- Aviso por correo -------------------------------------------------
#
# Para los reportes de quien no pudo pagar. Sin clave, el reporte se guarda
# igual y queda en el panel: lo único que se pierde es el aviso.
RESEND_API_KEY=""
CORREO_REMITENTE=""

# Root se reconoce por este correo, no por un rol guardado: así nadie
# puede otorgárselo desde la pantalla de usuarios. Vacío = no hay Root.
ROOT_EMAIL=""

# ---- Lo que cobra la pasarela por cobrar en línea ---------------------
#
# No es configuración de la escuela: es lo que cobra Stripe, y cambia según
# el año y según el contrato de la delegación. Vacío usa los valores de
# lista que trae el código.
#
# Tarifas de lista de Stripe en México: 3.6 % + $3 por transacción con
# tarjeta nacional. Una tarjeta extranjera lleva 1.5 % extra; si hay cambio
# de divisa, 2 % más. Confírmalas contra el contrato real.
#
# El porcentaje va en por ciento (3.6 = 3.6 %) y el monto fijo en pesos.
COMISION_TARJETA_PORCENTAJE="3.6"
COMISION_TARJETA_FIJA="3"
COMISION_SPEI_PORCENTAJE="3.6"
COMISION_SPEI_FIJA="3"
COMISION_OXXO_PORCENTAJE="3.6"
COMISION_OXXO_FIJA="12"

# IVA sobre la comisión. En México, 16.
COMISION_IVA="16"

# OXXO tarda en confirmarse: deja de ofrecerse estos días antes del
# vencimiento, para que a nadie le caiga el recargo por esa tardanza.
COMISION_OXXO_DIAS_CORTE="3"

# Poner "false" para dejar de ofrecer un método. Cualquier otra cosa lo
# deja encendido: una variable mal escrita no debe dejar a la escuela sin
# forma de cobrar.
# COMISION_OXXO_ACTIVO="false"

# ---- El primer usuario ------------------------------------------------
#
# El seeder crea un administrador con esto. Sin las dos primeras no crea
# ninguna cuenta y avisa al terminar: es preferible quedarse sin entrar a
# que exista una cuenta con una contraseña que cualquiera puede leer.
#
# La contraseña necesita al menos 8 caracteres. Al volver a sembrar no se
# reescribe: si ya la cambiaron desde el panel, ese cambio manda.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NOMBRE=""

# ---- Usuarios de prueba -----------------------------------------------
#
# La contraseña de admin@example.com, capturista@example.com y
# profesor@example.com, que crea el seeder de demostración. Vacía, no los
# crea. Nunca la pongas en un despliegue real.
DEMO_PASSWORD=""
